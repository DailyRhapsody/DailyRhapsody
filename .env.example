# 站点公开 URL（用于 metadata、Open Graph 等绝对地址；生产示例：https://tengjun.org）
# NEXT_PUBLIC_SITE_URL=https://tengjun.org

# 文章页 /blog 顶栏背景音乐（必填才有音乐+头像旋转；勿把 mp3 提交 Git，见 .gitignore）
# 推荐：上传音频到 CDN / 对象存储后填写 HTTPS 直链：
# NEXT_PUBLIC_ENTRIES_BGM_SRC=https://your-cdn.com/audio/song.mp3
# 本地开发可把 mp3 放在 public/audio/（已被 gitignore），并写相对站点根路径，例如：
# NEXT_PUBLIC_ENTRIES_BGM_SRC=/audio/houlai-dewomen.mp3

# 管理员登录密码（必填）
ADMIN_PASSWORD=your-secret-password

# 登录会话签名密钥，至少 16 个字符（必填）
AUTH_SECRET=your-auth-secret-at-least-16-chars

# （可选，企业级）Upstash Redis：用于多实例统一的 API 限流；不配置时仍使用单实例内存限流
# https://upstash.com/
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Notion CMS（日记内容源，替代 PostgreSQL diaries 表）
# 在 https://www.notion.so/my-integrations 创建 internal integration 获取 token
# NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxx
# NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOTION_GALLERY_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Reference 栏目数据库（NetNewsWire + Notion Web Clipper 收藏的内容）
# Properties: Name(title), URL(url), Source(select), Tag(multi-select), Public(checkbox), ClippedAt(created_time)
# NOTION_REFERENCE_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 本地开发（next dev）默认不调用 Notion API：Notion 按 token 限速（约 3 req/s），本地与生产
# 共用这份额度。2026-09-18 事故：本地 dev server 用生产 token，每 5 分钟全量重拉一次，把生产
# 打到持续 429。确需回源时换用单独的 integration token，再打开此开关。
# 此开关只拦 next dev；本地 next build && next start 按生产模式运行，不受拦截，同样要用单独的 token。
# NOTION_ALLOW_DEV_FETCH=1
# 数据新鲜度由 NOTION_CACHE_STALE_S 控制（默认 300s，超过后台异步刷新，用户无感）。
# NOTION_CACHE_STALE_S=300
# NOTION_CACHE_TTL 是 Redis 硬 TTL 兜底，不是新鲜度旋钮，默认 48h，代码里有同值下限
# 钳制——配小了会被忽略。2026-08 事故：曾被配成 300，缓存每 5 分钟整个消失，用户
# 请求直接承担 20-53s 的 Notion 全量冷拉，前端超时后文章列表显示「暂无文章」。
# NOTION_CACHE_TTL=172800

# Vercel Cron 预热鉴权（vercel.json 每日调 /api/cron/warm-cache，让缓存 key 永不缺席）
# CRON_SECRET=your-cron-secret

# 按需刷新密钥：POST /api/revalidate，secret 走 Authorization: Bearer <此值>
# （不能放 query string——会落入访问日志 / Referer / 浏览器历史）
# REVALIDATE_SECRET=your-revalidate-secret

# AI 辅助（后台 Markdown 编辑器，仅管理员可用）。Cursor 会员无对外 API，需自配 OpenAI 兼容服务。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# AI 数字人（右下角像素宇航员），说明见 docs/pet-digital-twin.md
# 生产环境必须配置上面的 Upstash / KV：访客人设包存放在 Redis，缺失时对话接口一律返回 503
# 开关：off（默认，不渲染）/ owner（仅管理员可见，上线前自测）/ public（对访客开放）。客户端构建时内联，改了要重新部署
# NEXT_PUBLIC_PET_MODE=off
# 模型协议：openai（默认，DeepSeek、Kimi、通义、OpenRouter 等兼容服务都走这条）或 anthropic
# PERSONA_LLM_PROTOCOL=openai
# PERSONA_LLM_API_KEY=
# PERSONA_LLM_BASE_URL=
# PERSONA_LLM_MODEL=
# openai 协议下未配 PERSONA_LLM_* 时沿用上面的 OPENAI_API_KEY / OPENAI_BASE_URL / AI_MODEL
# 本地调试：非生产环境下从该目录读 public.json / owner.json，不碰线上 Redis（.env.local 的 KV 凭证指向生产库）
# PERSONA_BUNDLE_DIR=
